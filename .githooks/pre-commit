#!/bin/sh
# Blocks any commit whose staged changes contain an Anthropic API key.
# Enabled per clone with: git config core.hooksPath .githooks

if git diff --cached -U0 --no-color | grep '^+' | grep -qE 'sk-ant-[A-Za-z0-9_-]{8,}'; then
  echo "Commit blocked: the staged changes contain what looks like an Anthropic API key (sk-ant-...)." >&2
  echo "Keep keys in the ANTHROPIC_API_KEY environment variable or in dotnet user-secrets, never in files." >&2
  exit 1
fi
